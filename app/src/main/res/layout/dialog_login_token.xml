<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/LoginTokenDialogDesc"
        android:textColor="@color/subTextColor"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_login_token_input">

        <EditText
            android:id="@+id/login_token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="@string/LoginTokenHint"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="48dp"
            android:paddingBottom="12dp"
            android:textColor="@color/mainTextColor"
            android:textColorHint="@color/subLightTextColor"
            android:textSize="14sp" />

        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/login_token_visibility"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/LoginTokenVisibilityToggle"
            app:iiv_color="@color/subTextColor"
            app:iiv_icon="cmd-eye-outline" />
    </FrameLayout>

    <TextView
        android:id="@+id/login_token_help_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:padding="4dp"
        android:text="@string/LoginTokenHelpLink"
        android:textColor="@color/actionBlue"
        android:textSize="13sp" />

</LinearLayout>
